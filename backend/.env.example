# ============================================================
# 后端环境变量配置 - 复制此文件为 .env 并填写实际值
# ============================================================

# 数据库（默认 SQLite，生产建议换 PostgreSQL）
DATABASE_URL=sqlite:///./app.db
# PostgreSQL 示例：
# DATABASE_URL=postgresql://user:password@localhost:5432/docfusion

# LLM 接口配置
LLM_API_BASE=http://hangzhou.cstext.top:54352
LLM_API_KEY=your_api_key_here
LLM_MODEL=claude-sonnet-4-6
LLM_API_FORMAT=anthropic

# 向量嵌入模型（首次启动会自动下载）
EMBEDDING_MODEL=all-MiniLM-L6-v2

# JWT 密钥（生产环境必须设置为随机长字符串）
SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MCP 功能开关
MCP_ENABLED=true

# 表格填充：find_best 分低时的弱匹配兜底（xlsx/xls 结构化路径，默认开启）
# TABLE_FILL_WEAK_FALLBACK_ENABLED=true
# 语义映射最低分下限（默认 0.25，上限在代码中钳制）
# TABLE_FILL_WEAK_MAP_MIN_SCORE=0.25
# 弱兜底写入映射时的置信度上限
# TABLE_FILL_WEAK_CONFIDENCE_CAP=0.65
